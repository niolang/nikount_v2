# Configuration de PRODUCTION (docker-compose.prod.yml).
# Sur le serveur : cp .env.production.example .env, puis remplir chaque valeur.
# Ce fichier .env contient des secrets : ne jamais le versionner, le garder en chmod 600.

# Nom de domaine servi par Caddy (certificat HTTPS obtenu automatiquement).
SITE_ADDRESS=nikount.example.org
# URL publique complète, en HTTPS (utilisée pour construire les liens de partage).
PUBLIC_BASE_URL=https://nikount.example.org

# PostgreSQL. Deux rôles : le propriétaire (migrations, sauvegardes) et celui de l'API, sans
# droits DDL. Mots de passe longs et aléatoires, différents, ex. openssl rand -hex 24
POSTGRES_USER=nikount
POSTGRES_PASSWORD=
POSTGRES_DB=nikount
POSTGRES_APP_USER=nikount_app
POSTGRES_APP_PASSWORD=

# Clé de chiffrement des liens participants (32 octets en base64), ex. openssl rand -base64 32
# À SAUVEGARDER hors du serveur : la perdre rend les liens participants non réaffichables.
TOKEN_ENCRYPTION_KEY=

LOG_LEVEL=info

# Sauvegardes (service backup) : heure UTC, durée de conservation, dossier de l'hôte.
BACKUP_HOUR=03
BACKUP_KEEP_DAYS=14
BACKUP_HOST_DIR=./backups
