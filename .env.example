# Copier en .env pour le développement local. Ne jamais versionner de vraies valeurs.

# PostgreSQL (docker compose)
POSTGRES_USER=nikount
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nikount

# API
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
DATABASE_URL=postgres://nikount:change-me@localhost:5432/nikount
LOG_LEVEL=info
# Nombre de proxys de confiance devant l'API (Caddy = 1). 0 en dev sans proxy.
TRUST_PROXY=0
PUBLIC_BASE_URL=http://localhost:5173

# Front (dev server Vite) : cible du proxy /api
VITE_API_PROXY_TARGET=http://localhost:3000

# Clé de chiffrement des liens participants stockés en base (32 octets en base64, décision D17).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Une clé différente par environnement ; la perdre rend les liens participants non réaffichables.
TOKEN_ENCRYPTION_KEY=

# Limites (valeurs par défaut)
# RATE_LIMIT_CREATE_PER_HOUR=10
# AUTH_FAILURE_MAX=20
# AUTH_FAILURE_WINDOW_MINUTES=10
# AUTH_FAILURE_BLOCK_MINUTES=15
